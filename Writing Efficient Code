import java.io.*;
import java.util.*;

public class Solution {

    public static List<Integer> maxSubarray(List<Integer> arr) {
        int current = arr.get(0);
        int maxContiguous = arr.get(0);

        for (int i = 1; i < arr.size(); i++) {
            current = Math.max(arr.get(i), current + arr.get(i));
            maxContiguous = Math.max(maxContiguous, current);
        }
        int maxNonContiguous = 0;
        int largest = arr.get(0);

        for (int x : arr) {
            if (x > 0) {
                maxNonContiguous += x;
            }
            largest = Math.max(largest, x);
        }
        if (maxNonContiguous == 0) {
            maxNonContiguous = largest;
        }

        return Arrays.asList(maxContiguous, maxNonContiguous);
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bw = new BufferedWriter(new FileWriter(System.getenv("OUTPUT_PATH")));

        int t = Integer.parseInt(br.readLine().trim());

        for (int test = 0; test < t; test++) {
            int n = Integer.parseInt(br.readLine().trim());

            String[] input = br.readLine().trim().split(" ");

            List<Integer> arr = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                arr.add(Integer.parseInt(input[i]));
            }

            List<Integer> result = maxSubarray(arr);

            bw.write(result.get(0) + " " + result.get(1));
            bw.newLine();
        }

        bw.close();
        br.close();
    }
}
