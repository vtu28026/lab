import java.util.*;
import java.util.stream.*;

class SensorReading {
    String sensorId;
    double temperature;

    SensorReading(String sensorId, double temperature) {
        this.sensorId = sensorId;
        this.temperature = temperature;
    }

    public String getSensorId() {
        return sensorId;
    }

    public double getTemperature() {
        return temperature;
    }
}

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        List<SensorReading> readings = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String id = sc.next();
            double temperature = sc.nextDouble();

            readings.add(new SensorReading(id, temperature));
        }

        Map<String, Double> averageMap = readings.stream()
                .filter(r -> r.getTemperature() > 50)
                .collect(Collectors.groupingBy(
                        SensorReading::getSensorId,
                        Collectors.averagingDouble(
                                SensorReading::getTemperature
                        )
                ));

        averageMap.entrySet()
                .stream()
                .sorted(
                        Map.Entry.<String, Double>comparingByValue()
                                .reversed()
                                .thenComparing(Map.Entry.comparingByKey())
                )
                .forEach(entry ->
                        System.out.printf(
                                "%s %.1f%n",
                                entry.getKey(),
                                entry.getValue()
                        )
                );

        sc.close();
    }
}
